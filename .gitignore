```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js
*.jsx
*.ts
*.tsx
*.css
*.scss
*.sass
*.less
*.map

# Environment variables
.env
.env.local
.env.*

# IDE specific
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage
coverage/
htmlcov/
.coverage

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.pytest_cache/
.mypy_cache/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak

# Archives
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.7z
*.rar
*.gz
*.bz2
*.xz
*.zst
```